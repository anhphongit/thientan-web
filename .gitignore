# clasp — contains the private scriptId, never commit
.clasp.json
.clasprc.json

# Local secrets / notes
*.local
.env
secrets/

# Real business data must not be committed
data/
export/
*.csv
*.pdf

# Office temp/lock files (created while a file is open)
~$*

# OS / editor
.DS_Store
Thumbs.db
.vscode/settings.json
node_modules/
secret

# .claude local session state and temporary files (but NOT rules or project config)
.claude/session-state/
.claude/agent-memory/
.claude/metadata.json
.claude/.env
.claude/.ckignore  # generated by clasp
.claude/hooks/
.claude/output-styles/
.claude/schemas/